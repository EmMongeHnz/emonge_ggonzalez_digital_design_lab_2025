`timescale 1ns/1ps

module tb_mem_fsm;

  // ---------------- TB clock/reset ----------------
  logic clk;
  logic rst;

  // 20ns → 50 MHz (no es crítico; la FSM solo usa bordes)
  initial clk = 0;
  always #10 clk = ~clk;

  // ---------------- DUT I/O ----------------
  logic        evt_select;
  logic [3:0]  idx_in;

  logic        two_open;
  logic        is_match;
  logic [3:0]  pairs_left;
  logic [31:0] tiles_st_flat;   // {st15..st0}, c/u 2b

  logic        tick_1hz;        // en TB será un pulso de 1 ciclo cuando queramos
  logic [15:0] rnd;

  logic        req_open;
  logic        do_close_nonmatch;
  logic [3:0]  idx_out;

  logic        cur_player;
  logic [4:0]  sec_left;
  logic [3:0]  score_j1, score_j2;
  logic        game_over;

  // ---------------- Instancia DUT ----------------
  mem_fsm dut (
    .clk            (clk),
    .rst            (rst),

    .evt_select     (evt_select),
    .idx_in         (idx_in),

    .two_open       (two_open),
    .is_match       (is_match),
    .pairs_left     (pairs_left),
    .tiles_st_flat  (tiles_st_flat),

    .tick_1hz       (tick_1hz),
    .rnd            (rnd),

    .req_open       (req_open),
    .do_close_nonmatch(do_close_nonmatch),
    .idx_out        (idx_out),

    .cur_player     (cur_player),
    .sec_left       (sec_left),
    .score_j1       (score_j1),
    .score_j2       (score_j2),
    .game_over      (game_over)
  );

  // ===========================================================
  //  *** MODELO DE TABLERO EN EL TB ***
  //  - tb_id[0:15]  : IDs 0..7, 0..7 (parejas)
  //  - tb_st[0:15]  : 0=cubierta, 1=abierta, 2=removida
  //  - Responde a req_open / do_close_nonmatch
  //  - Calcula two_open / is_match y pairs_left
  // ===========================================================
  localparam int N = 16;

  logic [3:0] tb_id   [0:N-1];
  logic [1:0] tb_st   [0:N-1];

  // Mapa fijo de parejas (2 de cada ID)
  initial begin
    // 0..7,0..7 en orden; puedes aleatorizar si quieres
    int i;
    for (i=0;i<8;i++) begin
      tb_id[i]     = i[3:0];
      tb_id[i+8]   = i[3:0];
    end
  end

  // Re-empaquetar a tiles_st_flat = {st15..st0}, c/u 2 bits
  function automatic [31:0] pack_st;
    int k;
    begin
      pack_st = 32'b0;
      for (k=0;k<16;k++) begin
        pack_st[k*2 +: 2] = tb_st[k];
      end
    end
  endfunction

  // Cómputo combinacional de two_open / is_match
  function automatic void compute_open_match(
      output logic two,
      output logic match);
    int cnt;
    int first, second;
    begin
      cnt = 0; first = -1; second = -1;
      for (int k=0; k<16; k++) begin
        if (tb_st[k]==2'd1) begin
          if (cnt==0) first = k;
          else if (cnt==1) second = k;
          cnt++;
        end
      end
      two   = (cnt==2);
      match = (cnt==2) ? (tb_id[first]==tb_id[second]) : 1'b0;
    end
  endfunction

  // pairs_left = #parejas no removidas
  function automatic [3:0] compute_pairs_left;
    int removed;
    begin
      removed = 0;
      for (int k=0;k<16;k++) if (tb_st[k]==2'd2) removed++;
      compute_pairs_left = (8 - (removed>>1))[3:0];
    end
  endfunction

  // Modelo secuencial del tablero
  // - abre carta al ver req_open=1 y si está cubierta
  // - cierra las abiertas si do_close_nonmatch=1
  // - si hay dos abiertas con match, cambia a removidas
  // Nota: esto replica el comportamiento de tu mem_board.
  always_ff @(posedge clk or posedge rst) begin
    if (rst) begin
      for (int k=0;k<16;k++) tb_st[k] <= 2'd0;
    end else begin
      if (req_open && (tb_st[idx_out]==2'd0)) begin
        tb_st[idx_out] <= 2'd1;
      end
      if (do_close_nonmatch) begin
        for (int k=0;k<16;k++) if (tb_st[k]==2'd1) tb_st[k] <= 2'd0;
      end
      // Remover si hay dos abiertas que hacen match
      logic t2, m2; compute_open_match(t2, m2);
      if (t2 && m2) begin
        int a=-1, b=-1, cnt=0;
        for (int k=0;k<16;k++) if (tb_st[k]==2'd1) begin
          if (cnt==0) a=k; else b=k; cnt++;
        end
        if (a!=-1 && b!=-1) begin
          tb_st[a] <= 2'd2;
          tb_st[b] <= 2'd2;
        end
      end
    end
  end

  // Outputs combinacionales hacia el DUT
  always_comb begin
    tiles_st_flat = pack_st();
    compute_open_match(two_open, is_match);
    pairs_left = compute_pairs_left();
  end

  // ===========================================================
  //  UTILIDADES DE ESTÍMULO
  // ===========================================================
  // Genera un pulso de 1 ciclo en tick_1hz
  task automatic tick_seconds(input int n);
    for (int i=0;i<n;i++) begin
      @(negedge clk);
      tick_1hz = 1'b1;
      @(negedge clk);
      tick_1hz = 1'b0;
      // deja correr 2 ciclos entre segundos para que la FSM procese
      repeat (2) @(negedge clk);
    end
  endtask

  // Simula pulsar el botón de selección (evt_select) con idx
  task automatic press_select(input [3:0] idx);
    @(negedge clk);
    idx_in     = idx;
    evt_select = 1'b1;
    @(negedge clk);
    evt_select = 1'b0;
    // dar tiempo a FSM para avanzar de estado
    repeat (1) @(negedge clk);
  endtask

  // Forzar que el tiempo expire (de 15 a 0) sin selección
  task automatic exhaust_timer;
    tick_seconds(16); // incluye el 0 (según lógica de tu FSM)
  endtask

  // =================== CHECKERS ===================
  task automatic expect(input bit cond, input string msg);
    if (!cond) begin
      $error("FALLO: %s @t=%0t", msg, $time);
      $fatal(1);
    end
  endtask

  // =================== TEST SEQUENCE ===================
  initial begin
    // init
    evt_select = 0; idx_in = '0; tick_1hz = 0; rnd = 16'h1234;
    rst = 1;
    repeat (3) @(negedge clk);
    rst = 0;
    repeat (3) @(negedge clk);

    // -------- Reset expectations --------
    expect(cur_player==0, "J1 debe iniciar");
    expect(sec_left==5'd15, "timer debe iniciar en 15s");
    expect(score_j1==0 && score_j2==0, "scores deben iniciar en 0");
    $display("RESET OK");

    // -------- TEST 1: Acierto manual de J1 (retiene turno y +1) --------
    // Usamos una pareja conocida: (0,8) son ambos ID=0 en nuestro mapa
    press_select(4'd0);   // primera carta
    press_select(4'd8);   // segunda carta (match)
    // Permite a la FSM entrar a S_EVAL y actualizar
    repeat (3) @(negedge clk);
    expect(score_j1==1 && score_j2==0, "J1 debe sumar 1 al acertar");
    expect(cur_player==0, "J1 debe retener turno tras acertar");
    expect(sec_left==5'd15, "timer se resetea a 15 tras acierto");
    $display("TEST1 OK");

    // -------- TEST 2: Fallo manual de J1 (cierra y cede turno) --------
    // Elegimos dos diferentes IDs: (1,9) ambos son ID=1 → eso sería match; usa (1,10) (ID=1 vs ID=2)
    press_select(4'd1);    // abre ID=1
    press_select(4'd10);   // abre ID=2 → mismatch
    repeat (3) @(negedge clk);
    expect(score_j1==1 && score_j2==0, "no debe cambiar score en fallo");
    expect(cur_player==1, "debe ceder turno a J2 tras fallo");
    expect(sec_left==5'd15, "timer se resetea al cambiar turno");
    // y las abiertas deben haberse cerrado (modelo cierra tras do_close_nonmatch)
    expect(two_open==0, "no deben quedar dos abiertas tras fallo");
    $display("TEST2 OK");

    // -------- TEST 3: Timeout de J2 (auto-select) --------
    // Dejamos correr el timer; la FSM debe auto-abrir una carta (req_open con idx_out)
    int req_count_before = 0;
    // contabiliza req_open para ver que algo abrió
    fork
      begin
        for (int i=0;i<40;i++) begin
          @(posedge clk);
          if (req_open) req_count_before++;
        end
      end
      begin
        exhaust_timer(); // genera 16 "segundos"
      end
    join
    expect(req_count_before>0, "debe haber al menos un req_open por auto-select");
    $display("TEST3 OK (timeout)");


    // -------- TEST 4: Completar juego (forzando aciertos alternos) --------
    // Vamos a abrir sistemáticamente las parejas restantes para terminar la partida.
    // Recorre IDs 1..7; abre sus dos posiciones si no están removidas aún.
    for (int id=1; id<8; id++) begin
      // busca dos posiciones con ese id que no estén removidas
      int a=-1, b=-1;
      for (int k=0;k<16;k++) if (tb_id[k]==id && tb_st[k]!=2'd2) begin
        if (a==-1) a=k; else if (b==-1) b=k;
      end
      if (a!=-1 && b!=-1) begin
        // Asegura que sea el jugador actual el que suma (retendrá turno al acertar).
        // Si estamos en J2 y quieres repartir puntos, podrías forzar un fallo previo,
        // pero aquí solo verificamos que el juego termina en game_over.
        press_select(a[3:0]);
        press_select(b[3:0]);
        repeat (3) @(negedge clk);
      end
    end

    // Deja avanzar algunos ciclos para que la FSM detecte pairs_left==0
    repeat (10) @(negedge clk);
    expect(game_over==1, "debe activarse game_over cuando pairs_left llega a 0");
    $display("TEST4 OK (game over)");

    $display(">>> TODOS LOS TESTS PASARON <<<");
    $finish;
  end

endmodule

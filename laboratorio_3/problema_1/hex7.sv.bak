// hex7.sv — Decoder 0..F a 7 segmentos (a..g).
// Por defecto activo en bajo (DE10-Standard). Cambia ACTIVE_LOW=0 si lo quieres activo en alto.
module hex7 #(
    parameter bit ACTIVE_LOW = 1'b1
)(
    input  logic [3:0] d,      // dígito 0..15
    output logic [6:0] seg     // {a,b,c,d,e,f,g}
);
    logic [6:0] pat;           // patrón activo-en-alto intermedio

    always_comb begin
        unique case (d)
            4'h0: pat = 7'b1111110;
            4'h1: pat = 7'b0110000;
            4'h2: pat = 7'b1101101;
            4'h3: pat = 7'b1111001;
            4'h4: pat = 7'b0110011;
            4'h5: pat = 7'b1011011;
            4'h6: pat = 7'b1011111;
            4'h7: pat = 7'b1110000;
            4'h8: pat = 7'b1111111;
            4'h9: pat = 7'b1111011;
            4'hA: pat = 7'b1110111;
            4'hB: pat = 7'b0011111; // “b”
            4'hC: pat = 7'b1001110;
            4'hD: pat = 7'b0111101; // “d”
            4'hE: pat = 7'b1001111;
            default: pat = 7'b1000111; // “F”
        endcase
    end

    // Ajuste de polaridad
    always_comb begin
        if (ACTIVE_LOW) seg = ~pat; else seg = pat;
    end
endmodule

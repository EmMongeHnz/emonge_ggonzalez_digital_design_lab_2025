// mem_board.sv — tablero y operaciones básicas
module mem_board(
  input  logic        clk, input logic rst,
  input  logic        do_shuffle,          // inicializar+barajar
  input  logic        do_close_nonmatch,   // cerrar las abiertas (si no son par)
  input  logic        req_open,            // abrir carta en idx si está cubierta
  input  logic [3:0]  idx,                 // 0..15
  input  logic [15:0] rnd,                 // para barajar

  output logic [3:0]  sel_a, sel_b,        // dos abiertas (si existen)
  output logic        two_open,
  output logic        is_match,
  output logic [3:0]  id  [0:15],
  output logic [1:0]  st  [0:15],          // 0/1/2
  output logic [3:0]  pairs_left           // cuántas parejas faltan
);
  typedef struct packed {logic [3:0] id; logic [1:0] st;} tile_t;
  tile_t t[0:15];

  // baraja estilo Fisher-Yates en un ciclo (16 fijo → sintetizable en Quartus)
  task automatic shuffle();
    int i,j; tile_t tmp;
    for (i=0;i<16;i++) begin t[i].id = (i%8); t[i].st = 2'd0; end
    for (i=15;i>0;i--) begin
      j = (rnd >> (i%16)) % (i+1);
      tmp=t[i]; t[i]=t[j]; t[j]=tmp;
    end
  endtask

  // exportar arrays
  integer k;
  always_comb begin
    for (k=0;k<16;k++) begin id[k]=t[k].id; st[k]=t[k].st; end
  end

  // detectar abiertas y match
  function automatic void scan(output logic[3:0] a,b; output logic two);
    int i; a=4'hF; b=4'hF; two=0;
    for (i=0;i<16;i++) if (t[i].st==2'd1) begin
      if (a==4'hF) a=i[3:0]; else if (b==4'hF) begin b=i[3:0]; two=1; end
    end
  endfunction

  always_comb begin
    scan(sel_a, sel_b, two_open);
    is_match = (two_open && (t[sel_a].id == t[sel_b].id));
  end

  // parejas restantes
  always_comb begin
    int rem=8, i;
    for (i=0;i<16;i+=2) begin end
    for (i=0;i<16;i++) if (t[i].st==2'd2) rem -= 1'b0; // cada carta removida no resta dos,
    // aproximamos con conteo de pares: 8 - (#removidas)/2
    rem = 8 - ( ( (t[0].st==2)+(t[1].st==2)+(t[2].st==2)+(t[3].st==2)
                + (t[4].st==2)+(t[5].st==2)+(t[6].st==2)+(t[7].st==2)
                + (t[8].st==2)+(t[9].st==2)+(t[10].st==2)+(t[11].st==2)
                + (t[12].st==2)+(t[13].st==2)+(t[14].st==2)+(t[15].st==2) ) >> 1 );
    pairs_left = rem[3:0];
  end

  // secuencia
  always_ff @(posedge clk) begin
    if (rst) shuffle();
    else begin
      if (do_shuffle) shuffle();
      if (do_close_nonmatch) begin
        for (k=0;k<16;k++) if (t[k].st==2'd1) t[k].st <= 2'd0;
      end
      if (req_open && (t[idx].st==2'd0)) t[idx].st <= 2'd1;
      // cuando ya hay 2 abiertas y hacen par, marcarlas removidas
      if (two_open && is_match) begin
        t[sel_a].st <= 2'd2; t[sel_b].st <= 2'd2;
      end
    end
  end
endmodule

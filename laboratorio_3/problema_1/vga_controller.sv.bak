// vga_controller.sv
// Envuelve vga_timing y produce RGB + HS/VS. Parametrizable en resolución y bits de color.

module vga_controller #(
    // Timing (por defecto 640x480@60)
    parameter int H_ACTIVE = 640, parameter int V_ACTIVE = 480,
    parameter int H_FP=16, parameter int H_SYNC=96, parameter int H_BP=48,
    parameter int V_FP=10, parameter int V_SYNC=2,  parameter int V_BP=33,
    parameter bit HS_POL=1'b0, parameter bit VS_POL=1'b0,

    // Profundidad de color por canal (DE10-Standard suele tener 10)
    parameter int N_COLOR_BITS = 10,

    // 1 = usar patrón de prueba interno, 0 = usar rgb_in
    parameter bit USE_TEST_PATTERN = 1'b1
)(
    input  logic                           clk_pix,
    input  logic                           rst,

    // Entrada opcional de color (si USE_TEST_PATTERN=0)
    input  logic [N_COLOR_BITS-1:0]        rgb_in_r,
    input  logic [N_COLOR_BITS-1:0]        rgb_in_g,
    input  logic [N_COLOR_BITS-1:0]        rgb_in_b,

    // Salida a DAC VGA
    output logic                           hsync,
    output logic                           vsync,
    output logic [N_COLOR_BITS-1:0]        vga_r,
    output logic [N_COLOR_BITS-1:0]        vga_g,
    output logic [N_COLOR_BITS-1:0]        vga_b,

    // Coordenadas útiles para lógicas externas
    output logic                           video_on,
    output logic [11:0]                    x,
    output logic [11:0]                    y
);

    // Instancia de timing
    vga_timing #(
        .H_ACTIVE(H_ACTIVE), .V_ACTIVE(V_ACTIVE),
        .H_FP(H_FP), .H_SYNC(H_SYNC), .H_BP(H_BP),
        .V_FP(V_FP), .V_SYNC(V_SYNC), .V_BP(V_BP),
        .HS_POL(HS_POL), .VS_POL(VS_POL)
    ) u_timing (
        .clk_pix(clk_pix),
        .rst    (rst),
        .hsync  (hsync),
        .vsync  (vsync),
        .video_on(video_on),
        .x      (x),
        .y      (y),
        .line_tick(), .frame_tick()
    );

    // Patrón de prueba (barras y gradiente)
    logic [N_COLOR_BITS-1:0] test_r, test_g, test_b;

    if (USE_TEST_PATTERN) begin : g_test
        // Barras verticales + gradiente horizontal en G
        // 8 barras en 640 → 80 px cada una; generalizamos:
        localparam int BARS = 8;
        wire [11:0] seg_w = (H_ACTIVE / BARS);

        logic [2:0] bar_sel;
        always_comb begin
            bar_sel = (x < seg_w*1) ? 3'd0 :
                      (x < seg_w*2) ? 3'd1 :
                      (x < seg_w*3) ? 3'd2 :
                      (x < seg_w*4) ? 3'd3 :
                      (x < seg_w*5) ? 3'd4 :
                      (x < seg_w*6) ? 3'd5 :
                      (x < seg_w*7) ? 3'd6 : 3'd7;
        end

        // Gradiente horizontal en G:
        // Escalamos x (0..H_ACTIVE-1) a N_COLOR_BITS
        function automatic [N_COLOR_BITS-1:0] grad(input [11:0] xx);
            // shift proporcional (aprox) sin multiplicar
            int maxv = (1<<N_COLOR_BITS) - 1;
            int val  = (xx * maxv) / (H_ACTIVE-1);
            return logic'(val[N_COLOR_BITS-1:0]);
        endfunction

        always_comb begin
            unique case (bar_sel)
                3'd0: begin test_r = {N_COLOR_BITS{1'b1}}; test_g = '0;                        test_b = '0;                        end // Rojo
                3'd1: begin test_r = '0;                        test_g = {N_COLOR_BITS{1'b1}}; test_b = '0;                        end // Verde
                3'd2: begin test_r = '0;                        test_g = '0;                        test_b = {N_COLOR_BITS{1'b1}}; end // Azul
                3'd3: begin test_r = {N_COLOR_BITS{1'b1}}; test_g = {N_COLOR_BITS{1'b1}}; test_b = '0;                        end // Amarillo
                3'd4: begin test_r = {N_COLOR_BITS{1'b1}}; test_g = '0;                        test_b = {N_COLOR_BITS{1'b1}}; end // Magenta
                3'd5: begin test_r = '0;                        test_g = {N_COLOR_BITS{1'b1}}; test_b = {N_COLOR_BITS{1'b1}}; end // Cian
                3'd6: begin test_r = {N_COLOR_BITS{1'b1}}; test_g = {N_COLOR_BITS{1'b1}}; test_b = {N_COLOR_BITS{1'b1}}; end // Blanco
                default: begin test_r = '0; test_g = '0; test_b = '0; end // Negro
            endcase

            // Añadimos gradiente en G (mezcla simple)
            test_g = test_g >> 2; // baja base
            test_g = test_g + (grad(x) >> 2); // añade gradiente
        end
    end else begin : g_passthrough
        always_comb begin
            test_r = rgb_in_r;
            test_g = rgb_in_g;
            test_b = rgb_in_b;
        end
    end

    // Salida: negro fuera de la zona visible
    always_ff @(posedge clk_pix) begin
        if (rst) begin
            vga_r <= '0; vga_g <= '0; vga_b <= '0;
        end else if (video_on) begin
            vga_r <= test_r;
            vga_g <= test_g;
            vga_b <= test_b;
        end else begin
            vga_r <= '0;
            vga_g <= '0;
            vga_b <= '0;
        end
    end

endmodule

// logic_ops.sv
// Operaciones lógicas y shifts usando operadores de SystemVerilog.

module logic_ops #(
  parameter int N = 4
) (
  input  logic [N-1:0] A,
  input  logic [N-1:0] B,              // también se usa como fuente de SHAMT (LSBs)
  output logic [N-1:0] ANDY,
  output logic [N-1:0] ORY,
  output logic [N-1:0] XORY,
  output logic [N-1:0] SLLY,           // logical shift left
  output logic [N-1:0] SRLY            // logical shift right
);
  localparam int S = (N <= 1) ? 1 : $clog2(N) + 1;  // ancho seguro para SHAMT
  wire [S-1:0] SHAMT = B[S-1:0];

  assign ANDY = A & B;
  assign ORY  = A | B;
  assign XORY = A ^ B;
  assign SLLY = A << SHAMT;
  assign SRLY = A >> SHAMT;  // lógico (no aritmético)
endmodule
